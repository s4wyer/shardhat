/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src *; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none';
  Cache-Control: no-cache

/sw-download.js
  Cache-Control: no-cache

/pkg/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=3600, must-revalidate
